{
  "name": "pokeapi",
  "version": "0.0.1",
  "description": "Proyecto de PokeAPI con Astro y Tailwind CSS",
  "type": "module",
  "author": "",
  "license": "MIT",
  "packageManager": "pnpm@11.1.1",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "preinstall": "npx only-allow pnpm",
